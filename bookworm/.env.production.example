# ── BookWorm — Production Environment Variables ───────────────────────────────
# Copy this file to .env.production and fill in all values.
# NEVER commit .env.production to version control.
#
# Usage:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain ────────────────────────────────────────────────────────────────────
# Your public domain — used by Traefik for routing and TLS certificate issuance.
# Do NOT include https:// or a trailing slash.
# Example: bookworm.example.com
DOMAIN=

# Email Let's Encrypt uses to send certificate expiry warnings
ACME_EMAIL=

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bookworm
DB_USER=bookworm
# REQUIRED — use a strong random password (at least 32 chars)
DB_PASSWORD=

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# REQUIRED — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
